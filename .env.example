# PostgreSQL
DATABASE_URL=postgresql://tally:tally123@localhost:5432/tally_db

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Supported models: qwen3:8b, llama3.1:8b, deepseek-r1:8b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=120

# Application
LOG_LEVEL=INFO
SQL_ROW_LIMIT=1000
SCHEMA_MAX_TABLES=20
